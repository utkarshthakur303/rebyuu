# Copy to .env for local development. Never commit the real file.
#
# Where these come from:
#   Supabase dashboard -> Project Settings -> API
#
# Production does not read this file:
#   Vercel        -> Project Settings -> Environment Variables  (build-time)
#   GitHub Actions-> Settings -> Secrets and variables -> Actions (nightly sync)

VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable / anon key. Public by design — it ships in the client bundle.
VITE_SUPABASE_KEY=

# Secret / service_role key. Bypasses RLS on every table.
# Used only by scripts/syncAnime.ts. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
